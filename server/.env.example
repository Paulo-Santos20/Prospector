# Servidor
NODE_ENV=development
PORT=10000
# Origens separadas por vírgula (produção + localhost)
ALLOWED_ORIGINS=http://localhost:5173,https://prospector-dun.vercel.app

# Google Places (opcional; requer billing)
GOOGLE_MAPS_API_KEY=

# Foursquare Places API
FOURSQUARE_API_KEY=

# Geoapify Places + Geocoding API (free plan, sem cartão)
GEOAPIFY_API_KEY=

# TomTom Search + Geocoding API (free plan, sem cartão)
TOMTOM_API_KEY=

# Groq API Keys (fallback automático entre elas)
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=

# Gemini API (fallback final quando Groq falhar)
GEMINI_API_KEY=

# PageSpeed Insights (opcional)
PAGESPEED_API_KEY=

# Firebase Admin — escolha UMA das opções:
# 1) JSON completo em uma linha
FIREBASE_JSON=
# 2) Campos separados (a private key deve manter os \n escapados)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Migração do CRM legado (scripts/migrate-owner.js)
OWNER_UID=

# Acesso restrito: e-mails separados por vírgula. Vazio = qualquer conta autenticada.
ALLOWED_EMAILS=

# Limites e quotas diárias por usuário
MAX_LEADS_PER_SEARCH=20
MAX_SEARCHES_PER_DAY=50
MAX_ANALYSES_PER_DAY=100
MAX_AI_CALLS_PER_DAY=100
